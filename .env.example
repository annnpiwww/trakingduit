# TrackingDuit — semua variabel opsional.
# Tanpa satu pun di antaranya, app tetap jalan: data lokal di browser (IndexedDB)
# dan OCR pakai Tesseract di sisi klien.
# Copy jadi .env.local lalu isi yang dibutuhkan.

# ---------------------------------------------------------------- Supabase
# Aktifkan login akun cloud + sinkron antar perangkat.
# Jalankan supabase/schema.sql dulu di SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya untuk kebutuhan server/admin. Jangan pernah diprefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------- Google Spreadsheet
# Sinkron dua arah transaksi ke spreadsheet.
# 1. Buat service account di Google Cloud, aktifkan Google Sheets API.
# 2. Share spreadsheet ke email service account sebagai Editor.
# 3. GOOGLE_SHEET_ID = bagian /d/<ID>/edit pada URL spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Tempel private key satu baris; \n literal akan dikonversi otomatis.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Transactions

# ------------------------------------------------------------- OCR (opsional)
# Kalau diisi, /api/ocr pakai Google Vision (lebih akurat untuk struk termal).
# Kalau kosong, otomatis fallback ke Tesseract di browser.
GOOGLE_VISION_API_KEY=

# ------------------------------------------------------- AI Insight (opsional)
# Kalau kosong, halaman Insight tetap jalan pakai mesin rule-based lokal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ------------------------------------------------------- Tradu AI (opsional)
# Backend chat Tradu. Diisi khusus di dashboard Vercel — JANGAN isi secret di repo.
# TRADU_API_URL contoh: https://hermesagent.tailcb6f2e.ts.net/v1 (Tailscale Funnel)
# Chain: TRADU_MODEL dicoba dulu, lalu TRADU_FALLBACK_MODELS (koma-pisah),
# terakhir GEMINI_API_KEY. Tiap model dapat timeout sendiri; total dibatasi 55s.
TRADU_API_URL=
TRADU_API_KEY=
TRADU_MODEL=opencode/deepseek-v4-flash-free
TRADU_FALLBACK_MODELS=ollama-cloud/gemma4:31b,auto/best-chat

# ------------------------------------------------------- OCR AI (opsional)
# Vision OCR via OpenAI-compatible endpoint (Tailscale Funnel). Chain:
# OCR_MODEL -> OCR_FALLBACK_MODELS -> Gemini (GEMINI_API_KEY).
# Client fallback terakhir: Tesseract.js di browser (selalu jalan).
OCR_API_URL=
OCR_API_KEY=
OCR_MODEL=ollama-cloud/gemma4:31b
OCR_FALLBACK_MODELS=ocrgambar-copy,auto/best-vision

# ---------------------------------------------------------- Gemini (opsional)
# Fallback terakhir untuk Tradu & OCR kalau gateway Tailscale mati total.
GEMINI_API_KEY=
GEMINI_TRADU_MODEL=gemini-3.5-flash
GEMINI_OCR_MODEL=gemini-3.5-flash

# ------------------------------------------------------ Premium (mode uji)
# Kode aktivasi premium (lihat src/app/api/premium/activate). Ganti dengan
# webhook Midtrans/QRIS sebelum monetisasi live. PREMIUM_TRIAL_DAYS opsional.
PREMIUM_ACTIVATION_CODE=
PREMIUM_TRIAL_DAYS=30
